{
  "description": "Route protected PR writes through the shared collaboration guard.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/pr-write-guard.mjs\" --hook",
            "timeout": 5,
            "statusMessage": "Checking collaborative PR write routing"
          }
        ]
      }
    ]
  }
}
