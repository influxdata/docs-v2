.DS_Store
*~
public
.*.swp
node_modules
package-lock.json
.config*
**/.env*
*.log
/resources
.hugo_build.lock

# Content generation
/content/influxdb*/**/api/**/*.html
/content/influxdb*/**/api/**/*.md
!api-docs/**/.config.yml
/api-docs/redoc-static.html*
# Intermediate specs written by post-process-specs (overlays + tag configs)
/api-docs/_build/

# API documentation generation (generated by api-docs/scripts/)
/content/influxdb/*/api/**
/content/influxdb3/*/api/**
/content/influxdb3/*/reference/api/**
/content/enterprise_influxdb/*/api/**
/static/openapi
/data/article_data

# Exception: hand-crafted API conceptual pages (not generated)
!/content/influxdb3/*/api/administration/
!/content/influxdb3/*/api/administration/_index.md

/helper-scripts/output/*
/telegraf-build
!telegraf-build/templates
!telegraf-build/scripts
!telegraf-build/README.md

# CI/CD tool files
/cypress/downloads/*
/cypress/screenshots/*
/cypress/videos/*
.lycheecache
test-results.xml
/influxdb3cli-build-scripts/content
tmp
.tmp
.test-cache
.cache/
/.cache

# IDE files
.vscode/*
!.vscode/launch.json
.idea
**/config.toml

# TypeScript build output
**/dist/
# Exception: include compiled API doc scripts for easier use
!api-docs/scripts/dist/
**/dist-lambda/

# User context files for AI assistant tools
.context/*
!.context/README.md
.task.md
.claude/scheduled_tasks.lock

# External repos
.ext/*

# JavaScript/TypeScript build artifacts
*.tsbuildinfo
*.d.ts
*.d.ts.map
*.js.map
.eslintcache
.worktrees/

# Planning docs (kept locally, not tracked)
docs/plans/

# Migration parity baseline snapshot (Task 1) — local only
.parity-baseline/

# pnpm artifacts. This repo uses yarn; a stray `pnpm install` writes these and
# they should never be committed. scripts/check-package-manager.js refuses the
# install, and these keep the debris out of git if one predates that guard.
pnpm-lock.yaml
pnpm-workspace.yaml

# Git hooks are generated, not authored. `lefthook install` writes shims into
# this directory (core.hooksPath points here) and renames any it displaces to
# *.old, so the contents are rebuilt on every install. lefthook.yml is the
# source of truth and stays tracked.
.husky/
